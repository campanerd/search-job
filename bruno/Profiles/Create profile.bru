meta {
  name: Create profile
  type: http
  seq: 1
  tags: [
    Profiles
  ]
}

post {
  url: {{baseUrl}}/profiles
  body: json
  auth: inherit
}

body:json {
  {
    "userId": 0,
    "name": "",
    "level": "INTERN",
    "area": "QA",
    "workMode": "REMOTE",
    "contractType": "CLT",
    "city": "",
    "state": "",
    "minSalary": 0
  }
}

docs {
  The profile belongs to the user sent in the body.
}

example {
  name: 201 Response
  description: Profile created
  
  request: {
    url: {{baseUrl}}/profiles
    method: POST
    mode: json
    body:json: {
      {
        "userId": 0,
        "name": "",
        "level": "INTERN",
        "area": "QA",
        "workMode": "REMOTE",
        "contractType": "CLT",
        "city": "",
        "state": "",
        "minSalary": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "userId": 0,
          "name": "",
          "level": "INTERN",
          "area": "QA",
          "workMode": "REMOTE",
          "contractType": "CLT",
          "city": "",
          "state": "",
          "minSalary": 0,
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Missing userId, blank name, invalid value or negative minimum salary
  
  request: {
    url: {{baseUrl}}/profiles
    method: POST
    mode: json
    body:json: {
      {
        "userId": 0,
        "name": "",
        "level": "INTERN",
        "area": "QA",
        "workMode": "REMOTE",
        "contractType": "CLT",
        "city": "",
        "state": "",
        "minSalary": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "userId": 0,
          "name": "",
          "level": "INTERN",
          "area": "QA",
          "workMode": "REMOTE",
          "contractType": "CLT",
          "city": "",
          "state": "",
          "minSalary": 0,
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}


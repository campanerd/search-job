example {
  name: 409 Response
  description: The user already has a profile with this name (case-insensitive)
  
  request: {
    url: {{baseUrl}}/profiles
    method: POST
    mode: json
    body:json: {
      {
        "userId": 0,
        "name": "",
        "level": "INTERN",
        "area": "QA",
        "workMode": "REMOTE",
        "contractType": "CLT",
        "city": "",
        "state": "",
        "minSalary": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "userId": 0,
          "name": "",
          "level": "INTERN",
          "area": "QA",
          "workMode": "REMOTE",
          "contractType": "CLT",
          "city": "",
          "state": "",
          "minSalary": 0,
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

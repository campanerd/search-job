      content: '''
        [
          {
            "id": 0,
            "userId": 0,
            "name": "",
            "level": "INTERN",
            "area": "QA",
            "workMode": "REMOTE",
            "contractType": "CLT",
            "city": "",
            "state": "",
            "minSalary": 0,
            "createdAt": "",
            "updatedAt": ""
          }
        ]
      '''
    }
  }
}


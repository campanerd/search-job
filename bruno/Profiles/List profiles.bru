meta {
  name: List profiles
  type: http
  seq: 5
  tags: [
    Profiles
  ]
}

get {
  url: {{baseUrl}}/profiles
  body: none
  auth: inherit
}

params:query {
  userId: 
}

docs {
  Lists only the profiles of the given user.
}

example {
  name: 200 Response
  description: Profiles ordered by id (empty if the user has none)
  
  request: {
    url: {{baseUrl}}/profiles
    method: GET
    mode: none
    params:query: {
      userId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        [
          {
            "id": 0,
            "userId": 0,
            "name": "",
            "level": "INTERN",
            "area": "QA",
            "workMode": "REMOTE",
            "contractType": "CLT",
            "city": "",
            "state": "",
            "minSalary": 0,
            "createdAt": "",
            "updatedAt": ""
          }
        ]
      '''
    }
  }
}

example {
  name: 400 Response
  description: Missing userId
  
  request: {
    url: {{baseUrl}}/profiles
    method: GET
    mode: none
    params:query: {
      userId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  

example {
  name: 409 Response
  description: The user already has another profile with this name (case-insensitive)
  
  request: {
    url: {{baseUrl}}/profiles/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "userId": 0,
        "name": "",
        "level": "INTERN",
        "area": "QA",
        "workMode": "REMOTE",
        "contractType": "CLT",
        "city": "",
        "state": "",
        "minSalary": 0
      }
    }
  }
  

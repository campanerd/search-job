meta {
  name: Create user
  type: http
  seq: 5
  tags: [
    Users
  ]
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: inherit
}

body:json {
  {
    "name": ""
  }
}

example {
  name: 201 Response
  description: User created
  
  request: {
    url: {{baseUrl}}/users
    method: POST
    mode: json
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "name": "",
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Blank name or longer than 100 characters
  
  request: {
    url: {{baseUrl}}/users
    method: POST
    mode: json
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "name": "",
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: A user with this name already exists (case-insensitive)
  
  request: {
    url: {{baseUrl}}/users
    method: POST
    mode: json
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "name": "",
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

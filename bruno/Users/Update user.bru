example {
  name: 409 Response
  description: Another user already has this name (case-insensitive)
  
  request: {
    url: {{baseUrl}}/users/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "name": "",
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

meta {
  name: Update user
  type: http
  seq: 2
  tags: [
    Users
  ]
}

put {
  url: {{baseUrl}}/users/:id
  body: json
  auth: inherit
}

params:path {
  id: 
}

body:json {
  {
    "name": ""
  }
}

docs {
  Replaces the name of the user.
}

example {
  name: 200 Response
  description: User updated
  
  request: {
    url: {{baseUrl}}/users/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "name": "",
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Blank name or longer than 100 characters
  
  request: {
    url: {{baseUrl}}/users/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "name": "",
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}


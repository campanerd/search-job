meta {
  name: Troca o nome de um usuário
  type: http
  seq: 2
  tags: [
    Usuários
  ]
}

put {
  url: {{baseUrl}}/users/:id
  body: json
  auth: inherit
}

params:path {
  id: 
}

body:json {
  {
    "name": ""
  }
}

example {
  name: 200 Response
  description: Usuário atualizado
  
  request: {
    url: {{baseUrl}}/users/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "name": "",
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Nome em branco ou com mais de 100 caracteres
  
  request: {
    url: {{baseUrl}}/users/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "name": "",
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Usuário não existe
  
  request: {
    url: {{baseUrl}}/users/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "name": "",
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: Já existe outro usuário com esse nome (sem diferenciar maiúsculas)
  
  request: {
    url: {{baseUrl}}/users/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "name": "",
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

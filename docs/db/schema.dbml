Enum application_status {
  SAVED
  APPLIED
  INTERVIEW
  REJECTED
  DISCARDED
}

Enum job_source {
  MEU_PADRINHO
}

Enum level {
  INTERN
  JUNIOR
  MID
  SENIOR
  SPECIALIST
  TECH_LEAD
  STAFF
  COORDINATOR
}

Enum area {
  QA
  BACKEND
  FRONTEND
  FULLSTACK
  MOBILE
  DEVOPS
  DATA
  CX
  SECURITY
  AI
  PRODUCT
}

Enum work_mode {
  REMOTE
  ONSITE
  HYBRID
}

Enum contract_type {
  CLT
  PJ
}

Table app_user {
  id integer [pk, increment]
  name text [not null, note: 'unique, ignoring case (COLLATE NOCASE)']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    name [unique]
  }
}

Table profile {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  name text [not null, note: "'Davi - Java Backend'"]
  level level [note: 'optional']
  area area [note: 'optional']
  work_mode work_mode [note: 'optional']
  contract_type contract_type [note: 'optional']
  city text [note: 'optional']
  state text [note: 'optional']
  min_salary integer [note: 'optional']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (user_id, name) [unique, note: 'unique per user, ignoring case (COLLATE NOCASE)']
  }
}

Table job {
  id integer [pk, increment]
  source job_source [not null, note: 'where the job came from; for now only MEU_PADRINHO']
  external_id text [not null, note: 'job id at the source (nano_id at Meu Padrinho)']
  slug text [note: 'title part of the job page address at the source']
  title text [not null]
  company text
  platform text [note: 'where the job was published (LinkedIn, Gupy...)']
  url text [note: 'link to apply; only comes with the job detail, may stay empty']
  description text [note: 'only comes with the job detail']
  level level
  area area
  work_mode work_mode
  contract_type contract_type [note: 'only comes with the job detail']
  city text
  state text
  salary_min integer
  salary_max integer
  published_at timestamp [note: 'date of the job at the source']
  active integer [not null, default: 1, note: '0 = closed at the source (vaga_encerrada)']
  synced_at timestamp [not null, note: 'last time we saw the job']

  indexes {
    (source, external_id) [unique]
    active
    published_at
  }
}

Table job_application {
  user_id integer [not null, ref: > app_user.id]
  job_id integer [not null, ref: > job.id]
  status application_status [not null]
  applied_at timestamp [note: 'when it became APPLIED']
  notes text
  updated_at timestamp [not null]

  indexes {
    (user_id, job_id) [pk]
    status
  }
}

Table sync_run {
  id integer [pk, increment]
  source text [not null]
  started_at timestamp [not null]
  finished_at timestamp
  read_count integer
  new_count integer
  updated_count integer
  deactivated_count integer
}
